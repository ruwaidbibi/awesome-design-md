# --- Prospecting -------------------------------------------------------------
# Google Places API (New). Enable "Places API (New)" in Google Cloud and create
# an API key. Text Search with the websiteUri/userRatingCount field mask bills at
# the Enterprise SKU, so keep MAX_PAGES low while you are exploring.
GOOGLE_MAPS_API_KEY=

# fixtures | places   (fixtures needs no key and is the default when the key is absent)
PLACES_PROVIDER=places

# Each page is up to 20 places. 3 pages = the API maximum of 60 per search.
MAX_PAGES=3

# --- Generation --------------------------------------------------------------
# Used to generate the websites. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
GEN_MODEL=claude-opus-5
# low | medium | high | xhigh | max
GEN_EFFORT=high

# --- Social discovery --------------------------------------------------------
# Optional. Without one of these, socials are only found when Google itself
# lists a social URL as the business website.
BRAVE_SEARCH_KEY=
SERPAPI_KEY=

# Probe guessed handles (instagram.com/<slug>, facebook.com/<slug>).
# Off by default: it is noisy, rate limited, and only ever a low-confidence hint.
SOCIAL_GUESS=false

# --- Server ------------------------------------------------------------------
PORT=4317

# --- Photo analysis (optional, off by default) -------------------------------
# Reads a business's Google photos once to learn what the place looks like, then
# discards them. Photos are never stored and never appear on the generated site
# (Google's terms forbid both). Sending them to a model for analysis is a use
# those terms do not clearly address - read the README before enabling.
PHOTO_VISION=false
PHOTO_VISION_MAX=4
