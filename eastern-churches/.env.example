# --- LLM extraction (steps: harvest --llm, events --llm) -------------------
# Used to normalise parish directory pages and bulletin/calendar pages that
# publish no structured data. Leave unset to run structured-data-only.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_MODEL_HARD=claude-opus-5

# --- Meta Graph API (step: events --source=meta) --------------------------
# Requires YOUR OWN Meta app, reviewed for pages_read_engagement, plus a Page
# access token granted by each parish that opts in. There is no legitimate way
# to read parish Facebook/Instagram events without that grant; see README.
META_APP_ID=
META_APP_SECRET=
META_PAGE_TOKENS_FILE=./secrets/meta-page-tokens.json

# --- Geocoding ------------------------------------------------------------
# US Census geocoder needs no key. Nominatim is the fallback and REQUIRES a
# contact address in the User-Agent under its usage policy.
GEOCODER_CONTACT=you@example.com

# --- Crawler politeness ---------------------------------------------------
CRAWL_USER_AGENT=eastern-churches/0.1 (+https://github.com/YOURORG/eastern-churches)
CRAWL_CONCURRENCY=4
CRAWL_DELAY_MS=1500
